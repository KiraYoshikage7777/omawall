#!/bin/bash
# omawall plugin lifecycle, run by Service.qml.
#   on <plugin-dir>    install or refresh the daemon, key binding, menu entry
#   off-if-disabled    if the plugin is no longer enabled, undo all of that
# Every step is idempotent and quiet: it runs on each shell start.
set -u
ID="kirayoshikage7777.omawall"
SHARE="$HOME/.local/share/omawall"
STATE="$HOME/.local/state/omawall"
UNIT="$HOME/.config/systemd/user/omawall.service"
HYPR="$HOME/.config/hypr"
MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
LOG="$STATE/plugin.log"
mkdir -p "$SHARE" "$STATE"
exec >>"$LOG" 2>&1
[[ ${1:-} == off-if-disabled ]] || echo "== $(date '+%F %T') $*"


on() {
  local src=$1
  [[ -x $src/bin/omawall ]] || { echo "no binary in $src/bin"; exit 1; }

  # Binary: copied out of the plugin folder so remove/update never pulls it
  # from under the running daemon.
  local changed=0
  if ! cmp -s "$src/bin/omawall" "$SHARE/omawall"; then
    install -m755 "$src/bin/omawall" "$SHARE/omawall.new" && mv -f "$SHARE/omawall.new" "$SHARE/omawall"
    changed=1
  fi
  cp -f "$src/bin/omawall-plugin" "$SHARE/omawall-plugin"
  mkdir -p "$HOME/.local/bin"
  # ~/.local/bin/omawall: our link, or an older omawall copy; anything else is left alone.
  local link="$HOME/.local/bin/omawall"
  if [[ -L $link || ! -e $link ]] || grep -aq "omawall daemon" "$link" 2>/dev/null; then
    ln -sfn "$SHARE/omawall" "$link"
  fi

  # Steam's library for Wallpaper Engine workshop search, from any Steam game.
  if [[ ! -f $SHARE/libsteam_api.so ]]; then
    lib=$("$SHARE/omawall" steam lib 2>/dev/null | grep '^/' | head -1)
    [[ -n $lib ]] && cp -f "$lib" "$SHARE/libsteam_api.so"
  fi

  # The daemon.
  mkdir -p "${UNIT%/*}"
  local unit
  unit=$(cat <<U
# X-Omawall-Managed
[Unit]
Description=omawall wallpaper daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/share/omawall/omawall daemon
Restart=on-failure
RestartSec=1
Nice=5

[Install]
WantedBy=graphical-session.target
U
)
  if [[ ! -f $UNIT ]] || [[ $(cat "$UNIT") != "$unit" ]]; then
    printf '%s\n' "$unit" >"$UNIT"
    systemctl --user daemon-reload
    changed=1
  fi

  # Two wallpaper engines on one layer fight; remember what was on to restore it.
  if [[ ! -f $STATE/plugin-prev ]]; then
    {
      systemctl --user is-enabled -q owed.service 2>/dev/null && echo owed
      omarchy-plugin-list --json 2>/dev/null | jq -e 'any(.[]; .id == "omarchy.background" and .enabled)' >/dev/null 2>&1 && echo background
      systemctl --user is-enabled -q skwd-walld.service 2>/dev/null && echo skwd
    } >"$STATE/plugin-prev"
  fi
  for u in owed.service skwd-walld.service skwd-we-adapt.path; do
    systemctl --user is-enabled -q "$u" 2>/dev/null && systemctl --user disable --now "$u"
  done
  if omarchy-plugin-list --json 2>/dev/null | jq -e 'any(.[]; .id == "omarchy.background" and .enabled)' >/dev/null 2>&1; then
    omarchy-plugin-disable omarchy.background >/dev/null 2>&1 || true
  fi

  # A watcher on Omarchy's plugin list: disable and remove (from the menu or
  # the CLI) change shell.json, and the watcher undoes our changes then, even
  # when the shell tears the plugin down without giving it a chance to clean up.
  local wdir="${UNIT%/*}"
  printf '%s\n' "# X-Omawall-Managed" "[Unit]" "Description=omawall: notice when the Omarchy plugin is disabled or removed" "" \
    "[Path]" "PathChanged=%h/.config/omarchy/shell.json" "Unit=omawall-watch.service" "" "[Install]" "WantedBy=default.target" >"$wdir/omawall-watch.path.new"
  printf '%s\n' "# X-Omawall-Managed" "[Unit]" "Description=omawall: clean up after the Omarchy plugin" "" \
    "[Service]" "Type=oneshot" "ExecStart=/bin/bash %h/.local/share/omawall/omawall-plugin off-if-disabled" >"$wdir/omawall-watch.service.new"
  for f in omawall-watch.path omawall-watch.service; do
    if cmp -s "$wdir/$f.new" "$wdir/$f"; then rm -f "$wdir/$f.new"; else mv -f "$wdir/$f.new" "$wdir/$f"; wchanged=1; fi
  done
  [[ ${wchanged:-0} == 1 ]] && systemctl --user daemon-reload
  systemctl --user enable --now omawall-watch.path >/dev/null 2>&1

  systemctl --user enable omawall.service >/dev/null 2>&1
  if (( changed )) && systemctl --user is-active -q omawall.service; then
    systemctl --user restart omawall.service
  else
    systemctl --user start omawall.service
  fi

  # Older versions wrote a key binding, a layer rule and a menu entry into the
  # user's files. This version sets them at runtime instead (see Service.qml),
  # so take out only the lines those versions added.
  cleanup_files
  echo on: done
}

# Remove only what older omawall versions added to the user's files.
cleanup_files() {
  local changed=0
  for f in "$HYPR/bindings.lua" "$HYPR/looknfeel.lua"; do
    if [[ -f $f ]] && grep -q '^-- omawall:\|^o.rebind(.*omawall\|^hl.layer_rule(.*omawall' "$f"; then
      sed -i '/^-- omawall:/d; /^o.rebind(.*omawall/d; /^hl.layer_rule(.*omawall/d' "$f"
      changed=1
    fi
  done
  if [[ -f $MENU ]] && grep -q 'omawall toggle' "$MENU"; then
    prev=$(cat "$STATE/menu-prev" 2>/dev/null)
    case $prev in
      created) rm -f "$MENU" ;;
      inserted) sed -i '/"appearance.background".*omawall toggle/d' "$MENU" ;;
      "") ;; # not ours: someone else pointed the menu at omawall
      *) L="$prev" awk '/"appearance.background".*omawall toggle/ { print ENVIRON["L"]; next } { print }' "$MENU" >"$MENU.tmp" && mv "$MENU.tmp" "$MENU" ;;
    esac
    rm -f "$STATE/menu-prev"
  fi
  (( changed )) && hyprctl reload >/dev/null 2>&1
  return 0
}

off_if_disabled() {
  # A shell restart or reload also gets here: give the shell time to come
  # back, then act only if the plugin is really disabled or gone.
  sleep 2
  # Enabled means: the plugin folder is there and shell.json lists it (as a
  # service in plugins[] or as a widget in the bar). Asking the shell itself is
  # not reliable here — during a restart it answers before plugins load.
  local cfg="$HOME/.config/omarchy/shell.json"
  if [[ -f $HOME/.config/omarchy/plugins/$ID/manifest.json ]] &&
     jq -e --arg id "$ID" '[.. | objects | select(.id? == $id)] | length > 0' "$cfg" >/dev/null 2>&1 &&
     ! jq -e --arg id "$ID" '(.disabledPlugins // []) | index($id) != null' "$cfg" >/dev/null 2>&1; then
    exit 0
  fi
  echo "== $(date '+%F %T') plugin disabled or removed, cleaning up"
  systemctl --user disable --now omawall.service >/dev/null 2>&1
  grep -q X-Omawall-Managed "$UNIT" 2>/dev/null && rm -f "$UNIT"
  systemctl --user disable omawall-watch.path >/dev/null 2>&1
  systemctl --user stop omawall-watch.path >/dev/null 2>&1
  for f in omawall-watch.path omawall-watch.service; do
    grep -q X-Omawall-Managed "${UNIT%/*}/$f" 2>/dev/null && rm -f "${UNIT%/*}/$f"
  done
  systemctl --user daemon-reload

  cleanup_files
  # Drops the runtime key binding and brings Omarchy's own back.
  hyprctl reload >/dev/null 2>&1

  prev=$(cat "$STATE/plugin-prev" 2>/dev/null)
  if grep -q background <<<"$prev" || [[ -z $prev ]]; then
    omarchy-plugin-enable omarchy.background >/dev/null 2>&1 || true
  fi
  grep -q owed <<<"$prev" && systemctl --user enable --now owed.service >/dev/null 2>&1
  rm -f "$STATE/plugin-prev"

  [[ $(readlink "$HOME/.local/bin/omawall" 2>/dev/null) == "$SHARE/omawall" ]] && rm -f "$HOME/.local/bin/omawall"
  rm -f "$SHARE/omawall" "$SHARE/omawall-plugin"
  echo off: done
}

case ${1:-} in
  on) on "${2:?plugin dir}" ;;
  off-if-disabled) off_if_disabled ;;
  *) echo "usage: omawall-plugin on <dir> | off-if-disabled" >&2; exit 2 ;;
esac
